{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "baseUrl": "."
  },
  "include": ["js/**/*.js", "server/**/*.js", "scripts/**/*.js"],
  "exclude": ["node_modules"]
}
