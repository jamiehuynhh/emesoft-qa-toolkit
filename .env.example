# =============================================================================
#  AI QA Toolkit - server configuration
#  Copy this file to `.env` (same folder) and edit.
#  `.env` is git-ignored and is never served over http.
#
#  Pick ONE block below, uncomment it, and restart with `npm start`.
#  The browser always speaks the Claude Messages dialect; the server translates,
#  so all four AI tools work the same whichever provider you choose.
# =============================================================================


# --- A. Ollama - free forever, runs on this machine, nothing leaves it -------
# Best choice for internal logs / customer data, and the only option with no
# account and no card. Install from https://ollama.com/download then:
#     ollama pull llama3.2:3b
# On a 8 GB / 4 GB-VRAM laptop stay at 3B-4B. Point Ollama's model store at a
# drive with room:  setx OLLAMA_MODELS "D:\ollama-models"
#
# AI_PRESET=ollama
# AI_MODEL=llama3.2:3b


# --- B. Google Gemini - free tier, best quality of the free options ----------
# Key: https://aistudio.google.com/apikey  (Google account, no card)
# Note: on the FREE tier Google may use your prompts to improve their products.
# Do not send real customer data or internal logs through it.
#
# AI_PRESET=gemini
# AI_API_KEY=
# AI_MODEL=gemini-2.5-flash


# --- C. Groq - free tier, very fast, open models -----------------------------
# Key: https://console.groq.com/keys
#
# AI_PRESET=groq
# AI_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile


# --- D. OpenRouter - one key, many models, some marked :free -----------------
# Key: https://openrouter.ai/keys
#
# AI_PRESET=openrouter
# AI_API_KEY=
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free


# --- E. Cerebras - free tier, no card ----------------------------------------
# Key: https://cloud.cerebras.ai/
#
# AI_PRESET=cerebras
# AI_API_KEY=
# AI_MODEL=llama-3.3-70b


# --- E2. Mistral - free tier, no card ----------------------------------------
# Key: https://console.mistral.ai/api-keys
#
# AI_PRESET=mistral
# AI_API_KEY=
# AI_MODEL=mistral-small-latest


# --- E3. NVIDIA NIM - free tier ----------------------------------------------
# Key: https://build.nvidia.com/
#
# AI_PRESET=nvidia
# AI_API_KEY=
# AI_MODEL=meta/llama-3.1-8b-instruct


# NOTE: GitHub Models (AI_PRESET=github) was fully retired on 2026-07-30 and no
# longer works. The preset is kept only so an old .env fails with an explanation
# instead of silently falling back to another provider.


# --- F. Anthropic Claude - paid, highest quality (the default) ---------------
# Key: https://console.anthropic.com/  (needs credits, billed per token)
#
# AI_PRESET=anthropic
# AI_API_KEY=
# AI_MODEL=claude-opus-5


# --- Anything else that speaks OpenAI Chat Completions ----------------------
# Mistral, Together, Cloudflare Workers AI, an internal gateway, a mock server:
#
# AI_PROVIDER=openai
# AI_API_URL=https://your-gateway/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=your-model-id


# =============================================================================
#  Server options (all optional)
# =============================================================================

# Port the toolkit is served on.
PORT=8123

# Bind address. Keep 127.0.0.1 for a personal machine.
HOST=127.0.0.1


# =============================================================================
#  Sharing this with other people
#  -----------------------------------------------------------------------------
#  /api/ai spends money with your AI key. On loopback that is fine. The server
#  REFUSES to start with a non-loopback HOST unless one of the two lines below
#  is set - that refusal is deliberate, not a bug.
# =============================================================================

# Shared secret required on every /api/* call (static files stay public).
# Clients send:  Authorization: Bearer <token>
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_TOKEN=

# Only if something in front already authenticates (SSO proxy, service mesh).
# ALLOW_INSECURE_EXPOSURE=false

# Send HSTS. Turn on only when a TLS terminator sits in front, never on plain http.
# BEHIND_HTTPS=false

# Trust X-Forwarded-For for rate limiting. OFF by default: with no proxy in
# front it is attacker-controlled, so anyone could reset their own limit.
# TRUST_PROXY=false

# Per-client limits. The daily cap is what actually protects the bill.
# RATE_PER_MINUTE=20
# RATE_PER_DAY=500
# RATE_CONCURRENT=3

# "Direct" mode calls api.anthropic.com from the page, so CSP has to allow it.
# Add your own host here if you use "Custom" mode, space or comma separated.
# CSP_CONNECT_EXTRA=https://api.anthropic.com

# Append-only JSONL of who called what. Metadata only - never prompt text, so
# the log does not become a second copy of the data it audits.
# The logs/ folder is git-ignored and refused over http.
# AUDIT_LOG=logs/audit.jsonl
# AUDIT_ENABLED=true

# Ask the provider to report token counts in the stream. Off by default because
# some OpenAI-compatible servers reject the stream_options field.
AI_STREAM_USAGE=false

# Limits
MAX_BODY_BYTES=2097152
AI_TIMEOUT_MS=600000

# Legacy names still honoured, so an older .env keeps working:
#   ANTHROPIC_API_KEY, ANTHROPIC_API_URL, ANTHROPIC_VERSION
